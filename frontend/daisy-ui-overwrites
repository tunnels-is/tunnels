@import "tailwindcss";
@plugin "@tailwindcss/typography";
@plugin "daisyui" {
  themes:
    suzko --default,
    suzko-dark --prefersdark;
}

/* SUZKO Light Theme - F1 Racing Inspired */
@plugin "daisyui/theme" {
  name: "suzko";
  default: true;
  color-scheme: light;

  /* F1 Red Primary - #d82e2e */
  --color-primary: #d82e2e;
  --color-primary-content: #fff;

  /* Racing Grey Secondary */
  --color-secondary: #2c2c2c;
  --color-secondary-content: #fff;

  /* Red Accent */
  --color-accent: #d82e2e;
  --color-accent-content: #fff;

  /* Neutral - Dark Carbon Grey */
  --color-neutral: #121212;
  --color-neutral-content: #fff;

  /* Base - White backgrounds */
  --color-base-100: #ffffff;
  --color-base-200: #f9fafb;
  --color-base-300: #f3f4f6;
  --color-base-content: #121212;

  /* Status Colors */
  --color-info: #3b82f6;
  --color-info-content: #fff;
  --color-success: #22c55e;
  --color-success-content: #fff;
  --color-warning: #f59e0b;
  --color-warning-content: #121212;
  --color-error: #ef4444;
  --color-error-content: #fff;
  /* Border radius */
  --radius-selector: 0.5rem;
  --radius-field: 0.375rem;
  --radius-box: 0.5rem;

  /* Sizes */
  --size-selector: 0.25rem;
  --size-field: 0.25rem;

  /* Border */
  --border: 1px;

  /* Effects */
  --depth: 1;
  --noise: 0;
}

/* SUZKO Dark Theme - F1 Racing Inspired */
@plugin "daisyui/theme" {
  name: "suzko-dark";
  prefersdark: true;
  color-scheme: dark;

  /* Brighter F1 Red for dark mode - #d82e2e */
  --color-primary: #d82e2e;
  --color-primary-content: #fff;

  /* Medium Carbon Grey Secondary */
  --color-secondary: #2c2c2c;
  --color-secondary-content: #fff;
  /* Red Accent */
  --color-accent: #d82e2e;
  --color-accent-content: #fff;

  /* Neutral - Dark Carbon Grey */
  --color-neutral: #1a1a1a;
  --color-neutral-content: #fff;

  /* Base - Dark Carbon backgrounds */
  --color-base-100: #18181b;
  --color-base-200: #1f1f23;
  --color-base-300: #27272a;
  --color-base-content: #f4f4f5;

  /* Status Colors */
  --color-info: #3b82f6;
  --color-info-content: #fff;
  --color-success: #22c55e;
  --color-success-content: #fff;
  --color-warning: #f59e0b;
  --color-warning-content: #121212;
  --color-error: #ef4444;
  --color-error-content: #fff;
  /* Border radius */
  --radius-selector: 0.5rem;
  --radius-field: 0.375rem;
  --radius-box: 0.5rem;

  /* Sizes */
  --size-selector: 0.25rem;
  --size-field: 0.25rem;

  /* Border */
  --border: 1px;

  /* Effects */
  --depth: 1;
  --noise: 0;
}
